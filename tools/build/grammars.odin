// Grammar table: the source of truth for which tree-sitter grammars
// tools/build fetches and pins. Pins are upstream release tags or
// 40-hex commit SHAs (commit pins clone via fetch + checkout). The
// rows are generated from the gotreesitter registry by
// `odin run scripts/extract_table -- <gotreesitter-dir>`; the
// struct, the core pin, and find_grammar are fixed template parts.
package build

TREE_SITTER_REPO :: "https://github.com/tree-sitter/tree-sitter"
TREE_SITTER_TAG  :: "v0.26.9"

Grammar_Desc :: struct {
	name: string, // language id used by the registry and lib layout
	repo: string, // git URL to clone from
	tag:  string, // pinned release tag or 40-hex commit SHA
	path: string, // subdirectory inside the repo holding src/ ("" = root)
	// C symbol of the language entry point when it is not tree_sitter_<name>
	// (e.g. the C# grammar exports tree_sitter_c_sharp).
	symbol: string, // "" = tree_sitter_<name>
}

GRAMMARS :: []Grammar_Desc{
